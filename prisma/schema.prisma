// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User{
  id String @id @default(uuid())
  name String
  email String @unique
  password String
  createdAt DateTime? @default(now())
  isVerified Boolean @default(false)
  role String
  subdomain String?
  plan String @default("free")
  merchant_verify Boolean @default(false)
  subscription_id String?
  paddleCustomerId    String?
  



  merchantapp MerchantApps[]

  inventory Inventory[]
  resetTokens PasswordResetToken[]
  areaList AreaList[]
  fixedRate FixedRate[]


}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}





model RestList{
  id String @id @default(uuid()) 
  userId String @unique
  createdAt DateTime @default(now())
  restName String
  restAnnouncement String?
  restPhone String?
  restEmail String?
  restAddress String?
  restLogo String?
  restBanner String?
  logoId String?
  bannerId String?
  subdomain String? @unique()
  restSite String?
  restTheme String @default("red")
  restInstagram String?
  restFB String?
  metaTitle String?
  metaDesc String?
  customDomain String? @unique()
  preOrdersEnabled Boolean?
  preoOrderMinHours Int?
  preOrderMaxDays Int?
  pickUpWindows String[] 
  deliveryWindows String[] 
  lat Float?
  long Float?
  crimsonBranding Boolean @default(true)
  inventories Inventory[] 
  orders Orders[]
  coupons Coupon[]


}

model Inventory {
  id String @id @default(uuid())
  name String
  price Int
  description String?
  category String?
  imageUrl String?
  publicId String?
  userId String
  createdAt DateTime @default(now())
  variants InventVariants[]
  stockAmount Int @default(0)
  restId String
  costPrice String?
  restName String? 
  restlist RestList @relation(fields: [restId],references: [id],onDelete: Cascade)
  user User @relation(fields: [userId],references: [id],onDelete: Cascade)
}

model InventVariants {
  id String @id @default(uuid())
  variantName String 
  variantPrice Int
  variantCostPrice Int?
  createdAt DateTime @default(now())
  inventoryId String
  inventory Inventory @relation( fields: [inventoryId], references: [id],onDelete: Cascade)

}





model MerchantApps{
  id String @id @default(uuid())
  createdAt DateTime @default(now())
  userId String @unique()
  email String @unique()
  full_name String
  phone String
  business_name String
  address String?
  category String
  description String
  social_links String?
  cnic String
  status String @default("submitted")
  user User @relation(fields: [userId],references: [id],onDelete: Cascade)


}

model AreaList {
  id String @id @default(uuid())
  userId String
  restId String
  areaId String @unique() @default(uuid())
  areaName String 
  cityName String
  minOrder String
  deliveryFee String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId],references: [id],onDelete: Cascade)



}

model Coupon {
  id                   String   @id @default(uuid())
  code                 String   @unique
  discountPercentage   Int
  minOrder             Decimal  @default(0)
  expiry               DateTime
  maxUses              Int      @default(1)
  maxUsesPerUser       Int      @default(1)
  usedCount            Int      @default(0)
  isActive             Boolean  @default(true)

  userId               String?
  restId               String

  restlist             RestList @relation(fields: [restId], references: [id], onDelete: Cascade)
  couponUsages         CouponUsage[]
   orders               Orders[]
}

model CouponUsage {
  id        String   @id @default(uuid())
  couponId  String
  userId    String
  usedAt    DateTime @default(now())

  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
}

model Orders {
  id String @id @default(uuid())
  orderNumber String @unique()
  createdAt DateTime @default(now())
  custName String
  custEmail String
  custPhone String
  custAddress String
  orderDetails Json?
  recieveMethod String
  status String @default("pending")
  orderTotal Int
  restId String  
  restName String?
  deliveryArea String?
  deliveryFee String?
  restlist RestList @relation(fields: [restId],references: [id],onDelete: Cascade)
  couponId       String?
  couponCode     String?
  discountAmount Int      @default(0)
  isPreOrder Boolean?
  scheduledDate DateTime?
  scheduledWindow String?
  coupon         Coupon?  @relation(fields: [couponId], references: [id], onDelete: SetNull)

  


}

model FixedRate {
  id String @id @default(uuid())
  createdAt DateTime @default(now())
  rate Int
  userId String @unique()
  restId String @unique()
  fixMode Boolean
  FixMinOrder Int?

  user User @relation(fields: [userId],references: [id],onDelete: Cascade)

}






