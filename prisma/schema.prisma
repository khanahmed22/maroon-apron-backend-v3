generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String               @id @default(uuid())
  name                  String
  email                 String               @unique
  password              String?
  authProvider          String  @default("local") // "local" | "google"
  googleId              String? @unique
  createdAt             DateTime?            @default(now())
  isVerified            Boolean              @default(false)
  role                  String
  subdomain             String?
  plan                  String               @default("free")

  // paddle
  paddleSubscription_id String?
  paddleCustomerId      String?

  // revenuecat/google
  revenueCatAppUserId   String?

  billingProvider       String? // "paddle" | "googleplay" | null


  areaList              AreaList[]
  fixedRate             FixedRate?
  inventory             Inventory[]
  resetTokens           PasswordResetToken[]
  restList              RestList?
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String   @id @default(uuid())
  restId    String
  fcmToken  String   @unique
  createdAt DateTime @default(now())
  restlist  RestList @relation(fields: [restId], references: [id], onDelete: Cascade)
}

model RestList {
  id                String             @id @default(uuid())
  createdAt         DateTime           @default(now())
  restName          String?
  userId            String             @unique
  subdomain         String?            @unique
  metaDesc          String?
  metaTitle         String?
  restAddress       String?
  restBanner        String?
  restEmail         String?
  restFB            String?
  restInstagram     String?
  restLogo          String?
  restPhone         String?
  restSite          String?
  bannerId          String?
  logoId            String?
  customDomain      String?            @unique
  restTheme         String             @default("red")
  restAnnouncement  String?
  deliveryWindows   String[]
  pickUpWindows     String[]
  preOrderMaxDays   Int?
  preOrdersEnabled  Boolean?
  lat               Float?
  long              Float?
  crimsonBranding   Boolean            @default(true)
  preOrderMinHours  Int?
  orderingDisabled  Boolean            @default(false)
  deliveryEnabled   Boolean            @default(true)
  pickupEnabled     Boolean            @default(true)
  coupons           Coupon[]
  inventories       Inventory[]
  orders            Orders[]
  pushSubscriptions PushSubscription[]
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Inventory {
  id          String           @id @default(uuid())
  name        String
  price       Int
  userId      String
  createdAt   DateTime         @default(now())
  imageUrl    String?
  publicId    String?
  restId      String
  restName    String?
  category    String?
  stockAmount Int              @default(0)
  costPrice   String?
  description String?
  variants    InventVariants[]
  restlist    RestList         @relation(fields: [restId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InventVariants {
  id               String    @id @default(uuid())
  variantName      String
  variantPrice     Int
  createdAt        DateTime  @default(now())
  inventoryId      String
  variantCostPrice Int?
  inventory        Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
}

model AreaList {
  id          String   @id @default(uuid())
  areaId      String   @unique @default(uuid())
  createdAt   DateTime @default(now())
  deliveryFee String
  minOrder    String
  restId      String
  userId      String
  areaName    String
  cityName    String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Coupon {
  id                 String        @id @default(uuid())
  code               String        @unique
  discountPercentage Int
  minOrder           Decimal       @default(0)
  expiry             DateTime
  maxUses            Int           @default(1)
  maxUsesPerUser     Int           @default(1)
  usedCount          Int           @default(0)
  isActive           Boolean       @default(true)
  userId             String?
  restId             String
  restlist           RestList      @relation(fields: [restId], references: [id], onDelete: Cascade)
  couponUsages       CouponUsage[]
  orders             Orders[]
}

model CouponUsage {
  id       String   @id @default(uuid())
  couponId String
  userId   String
  usedAt   DateTime @default(now())
  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
}

model Orders {
  id              String    @id @default(uuid())
  custName        String
  custEmail       String
  custPhone       String
  custAddress     String
  orderDetails    Json?
  recieveMethod   String
  status          String    @default("pending")
  createdAt       DateTime  @default(now())
  orderNumber     String    @unique
  restId          String
  orderTotal      Int
  restName        String?
  deliveryArea    String?
  deliveryFee     String?
  couponCode      String?
  couponId        String?
  discountAmount  Int       @default(0)
  isPreOrder      Boolean?
  scheduledDate   DateTime?
  scheduledWindow String?
  paymentMethod String @default("cash")
  coupon          Coupon?   @relation(fields: [couponId], references: [id])
  restlist        RestList  @relation(fields: [restId], references: [id], onDelete: Cascade)
}

model FixedRate {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  rate        Int
  userId      String   @unique
  restId      String   @unique
  fixMode     Boolean
  FixMinOrder Int?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
